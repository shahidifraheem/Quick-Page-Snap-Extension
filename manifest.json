{
    "manifest_version": 3,
    "name": "Quick Page Snap - Take Full Page Screenshot",
    "version": "2.1",
    "description": "A powerful browser extension that lets you capture, edit, and download FULL PAGE web page screenshots with ease.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        },
        "default_title": "Take Full Page Screenshot"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}